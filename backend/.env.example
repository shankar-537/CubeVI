# Backend Environment Variables

# Comma-separated list of allowed frontend origins (no trailing slashes):
# For local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# In production (e.g. on Render / Railway):
# Set this to your deployed frontend domain:
# CORS_ORIGINS=https://cubevi.vercel.app,http://localhost:5173
